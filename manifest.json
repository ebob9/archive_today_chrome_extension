{
  "manifest_version": 3,
  "name": "Archive.today Helper (Unofficial)",
  "version": "1.0.1",
  "description": "Right-click links to submit to archive.today or search for snapshots. Unofficial, open-source project (MIT).",
  "author": "Aaron Edwards",
  "homepage_url": "https://github.com/ebob9/archive_today_chrome_extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
